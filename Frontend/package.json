{
  "name": "upsc-mentor-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "cross-env VITE_LOW_MEM=1 node --max-old-space-size=1536 ./node_modules/vite/bin/vite.js build",
    "build:low-mem": "cross-env VITE_LOW_MEM=1 node --max-old-space-size=768 ./node_modules/vite/bin/vite.js build",
    "build:terser": "node --max-old-space-size=1536 ./node_modules/vite/bin/vite.js build",
    "build:prod": "cross-env VITE_LOW_MEM=1 NODE_OPTIONS=--max-old-space-size=1536 vite build",
    "preview": "vite preview",
    "copy-syllabus": "node ../scripts/copy-upsc-syllabus.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:assets": "npx capacitor-assets generate --android --assetPath resources",
    "build:cap": "cross-env VITE_BASE=./ VITE_API_URL=https://studentportal.mentorsdaily.com/api VITE_LOW_MEM=1 node --max-old-space-size=1536 ./node_modules/vite/bin/vite.js build",
    "android:build": "npm run build:cap && npx cap sync android",
    "android:release": "npm run build:cap && npx cap sync android && cd android && .\\gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "axios": "^1.7.7",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.441.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.12.7",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "terser": "^5.36.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  }
}
