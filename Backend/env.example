PORT=5000
DATABASE_URL=your-mongodb-connection-string
MONGODB_URI=
JWT_SECRET=supersecretjwtkey

# Frontend URL used after OAuth redirects and by backend AI referer headers.
# Local dev: http://localhost:5173
# Production override: https://studentportal.mentorsdaily.com
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Backend public URL (no trailing slash)
# Local dev: http://localhost:5000
# Production override: https://studentportal.mentorsdaily.com
BASE_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
SERVER_URL=http://localhost:5000

# Google OAuth — add redirect URIs in Google Cloud Console → Credentials → OAuth client
# Local:  http://localhost:5000/api/auth/google/callback
# Prod:   https://studentportal.mentorsdaily.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

OPENROUTER_API_KEY=your-openrouter-api-key-here
# Vision copy evaluation (handwritten answer analysis — no OCR)
OPENROUTER_MODEL=google/gemini-2.5-flash
# Prelims MCQ generator — low-cost model, batched bilingual generation
OPENROUTER_TEST_MODEL=google/gemini-2.5-flash-lite
# Output token budget per batch (8 Q batch ≈ 8*420+300 = 3660 max; cap 5500)
TEST_GEN_TOKENS_PER_QUESTION=420
TEST_GEN_MAX_OUTPUT_TOKENS=5500
TEST_GEN_BATCH_SIZE=8
# Set true to generate explanation_en + explanation_hi for all 4 options (higher token cost)
# TEST_GEN_FULL_BILINGUAL_EXPLANATIONS=false

# Admin Prelims Mock (Schedule Mock / Go Live) — same token profile as prelims test
MIX_BATCH_SIZE=10
MIX_GENERATE_BUFFER=20
MIX_MAX_REFILL_BATCHES=15

# --- Topic Practice (admin 50Q) — token / cost tuning (RAG-tight defaults) ---
# Dedicated model (cheapest flash-lite recommended)
# OPENROUTER_PRACTICE_MODEL=google/gemini-2.5-flash-lite
# English MCQs first (~50% cheaper), then 1–2 Hindi batch calls (default)
PRACTICE_GEN_ENGLISH_ONLY=true
PRACTICE_GEN_BATCH_HINDI=true
# Set false for lowest cost (English-only tests, no Hindi)
# PRACTICE_GEN_BATCH_HINDI=false
PRACTICE_BATCH_SIZE=10
PRACTICE_GENERATE_BUFFER=5
PRACTICE_GEN_TOKENS_PER_QUESTION=380
PRACTICE_MAX_OUTPUT_TOKENS=4200
PRACTICE_TARGET_CONTEXT_TOKENS=420
PRACTICE_ABORT_CONTEXT_TOKENS=900
PRACTICE_WORD_SPLIT_THRESHOLD=1500
PRACTICE_CHUNK_MIN_WORDS=600
PRACTICE_CHUNK_MAX_WORDS=800
PRACTICE_CHUNK_OVERLAP_WORDS=50
PRACTICE_MIN_ACCEPTABLE_QUESTIONS=50
# Keep top-up / fill / refill low — vector context is already focused
PRACTICE_MAX_TOPUP_BATCHES=6
PRACTICE_BATCH_RETRIES=2
PRACTICE_BATCH_FILL_ROUNDS=3
PRACTICE_MAX_REFILL_BATCHES=5
PRACTICE_HINDI_BATCH_SIZE=5
PRACTICE_HINDI_TOKENS_PER_QUESTION=520
PRACTICE_HINDI_MAX_OUTPUT_TOKENS=8000
# TEST_GEN_FULL_MOCK_VERBOSE=true
# Hindi is included in the same OpenRouter call (recommended). Keep false.
ENABLE_HINDI_TRANSLATION=false
# Block any runtime Hindi LLM during exam attempts (DB fields only). Recommended: true
DISABLE_RUNTIME_HINDI_TRANSLATION=true
# Migrate existing English-only questions: npm run migrate:bilingual
# Optional fallback (copy EN→HI for toggle): npm run migrate:bilingual -- --hindi-fallback
# Only if you need legacy per-field Hindi API calls (many extra hits):
# TEST_GEN_USE_SEPARATE_HINDI_TRANSLATION=true

# Optional: Cloudinary for future cloud storage of copies
CLOUDINARY_URL=

# --- Notes → Topic Practice (content-grounded MCQs from notes.mentorsdaily.com) ---
# PDF chapter uploads (Step 1 — store; Step 2 — extract/chunk)
# NOTES_PDF_UPLOAD_DIR=uploads/notes-pdfs
# NOTES_PDF_MAX_BYTES=52428800
# Semantic chunking targets (words)
# NOTES_SEMANTIC_MIN_WORDS=400
# NOTES_SEMANTIC_MAX_WORDS=700
# NOTES_SEMANTIC_OVERLAP_WORDS=80
# Phase 3: target total LLM input 400–700 (hard max 900). Context body ≈500.
NOTES_RAG_TOP_K=3
NOTES_BATCH_CONTEXT_TOKENS=320
NOTES_KEYWORD_CONTEXT_TOKENS=280
PRACTICE_MAX_PROMPT_TOKENS=750
PRACTICE_POOL_BUFFER=20
PRACTICE_ALLOW_OPEN_KNOWLEDGE=true
NOTES_KEYWORD_CONTEXT_TOKENS=350
PRACTICE_MAX_PROMPT_TOKENS=900
# NOTES_MAX_CONTEXT_CHARS=14000
# NOTES_CHUNKS_PER_BATCH=5
# NOTES_RETRIEVAL_CACHE_MS=600000
# PRACTICE_BATCH_RETRIES=3
# NOTES_USE_EMBEDDINGS=false
# --- Embeddings (Step 3 — default BAAI/bge-m3, 1024-d) ---
# EMBEDDING_PROVIDER=bge-m3
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSION=1024
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_MAX_CHARS=8000
# Option A: HuggingFace Inference API
# HF_TOKEN=hf_xxxxxxxx
# Option B: OpenAI-compatible local server (TEI / Infinity / Xinference)
# EMBEDDING_BASE_URL=http://localhost:8080/v1
# EMBEDDING_API_KEY=
# Legacy OpenAI embeddings (set EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# If using OpenRouter for embeddings, set OPENAI_BASE_URL=https://openrouter.ai/api/v1
# and set OPENROUTER_API_KEY.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# --- Qdrant ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=notes_chunks
# QDRANT_VECTOR_SIZE=1024
# QDRANT_RECREATE_ON_DIM_MISMATCH=false
# QDRANT_UPSERT_BATCH=64
# Vector DB (legacy Pinecone — unused)
# PINECONE_API_KEY=
# PINECONE_INDEX=upsc-content
# PINECONE_NAMESPACE=content-chunks
# PINECONE_DIMENSION=1536
# CONTENT_SKIP_PINECONE=true

# GNews API (Daily UPSC Current Affairs)
GNEWS_API_KEY=your-gnews-api-key-here
# Optional: OpenRouter headers (usually not needed)
# OPENROUTER_HTTP_REFERER=https://studentportal.mentorsdaily.com
# OPENROUTER_X_TITLE=UPSC Mentor

# Current Affairs Research API Keys
NEWSAPI_KEY=your-newsapi-org-api-key
THE_HINDU_API_KEY=your-thehindu-api-key
PIB_API_KEY=your-pib-api-key
INDIAN_EXPRESS_API_KEY=your-indianexpress-api-key

# Research Configuration
RESEARCH_MAX_RETRIES=3
RESEARCH_TIMEOUT=30000
RESEARCH_CONCURRENCY=2
SCHEDULER_TIMEZONE=UTC

# Admin Configuration
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password